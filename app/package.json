{
  "name": "trivia",
  "version": "1.0.0",
  "description": "Trivia kata in typescript",
  "main": "src/main.ts",
  "scripts": {
    "start": "ts-node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && nyc mocha --recursive --require ts-node/register \"tests/**/*.test.ts\"",
    "golden-master": "ts-node scripts/generate-golden-master.ts"
  },
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/main.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text-summary",
      "text",
      "html"
    ]
  },
  "author": "Felix Blechschmitt",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.1.2",
    "mocha": "^12.0.2",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ts-node": {
      "diff": "^4.0.4"
    }
  }
}
